# 美股(可选,缺则自动降级到 yfinance)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Crypto
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# LLM(Plan 2 才用,这里先占位)
OLLAMA_HOST=http://127.0.0.1:11434
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 应用
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# 通知子系统 — SMTP 邮件发送
# 留空则邮件通道 enabled=False, 业务调用退化 noop(优雅降级)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=true
